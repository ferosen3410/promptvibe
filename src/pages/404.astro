---
import Layout from '../layouts/Layout.astro';
import PromptCard from '../components/PromptCard.astro';
import { prompts } from '../data/prompts';
---

<Layout title="Page not found" description="The page you were looking for does not exist." noindex>
  <section class="container article-head">
    <p class="eyebrow">Error 404</p>
    <h1>That page does not exist.</h1>
    <p class="muted" style="max-width:56ch">
      The link may be old or mistyped. You can go back to the <a href="/">home page</a>, browse <a href="/prompts">all prompts</a> or start with one of these:
    </p>
    <div class="grid" style="margin-top:1.4em">
      {prompts.slice(0, 3).map((entry) => <PromptCard entry={entry} />)}
    </div>
  </section>
</Layout>
