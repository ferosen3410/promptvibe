---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${SITE.name}`,
  url: `${SITE.url}/contact`,
};
---

<Layout
  title="Contact"
  description={`Contact ${SITE.name} to report an error, suggest a prompt or ask a question about the site.`}
  jsonLd={jsonLd}
>
  <article class="narrow article-head prose">
    <p class="crumbs"><a href="/">Home</a> / Contact</p>
    <h1>Contact</h1>
    <p>
      The quickest way to reach me is by email:
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. Please allow a few business days for a reply.
    </p>

    <h2>What you can write about</h2>
    <ul>
      <li><strong>Errors and outdated information.</strong> Tell me which page and what is wrong. I will fix it and update the review date.</li>
      <li><strong>Prompt requests.</strong> Describe the task, who it is for and what a good result looks like.</li>
      <li><strong>Privacy questions.</strong> Requests about your data are covered in the <a href="/privacy">Privacy Policy</a>.</li>
      <li><strong>Business and advertising enquiries.</strong> Include your company and what you have in mind.</li>
    </ul>

    <h2>What I cannot help with</h2>
    <p>
      I cannot give personal legal, medical or financial advice, and I cannot debug your private code by email. For those, a qualified professional is the right place to start.
    </p>

    <p><a class="btn" href={`mailto:${SITE.email}`}>Send an email</a></p>
  </article>
</Layout>
