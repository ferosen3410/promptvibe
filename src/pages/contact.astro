---
const title = "Contact PromptVibe HQ";
const description = "Contact PromptVibe HQ with questions, corrections, or suggestions.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | PromptVibe HQ</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href="https://www.promptvibehq.com/contact" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      *{box-sizing:border-box;margin:0;padding:0}
      body{background:#0e0e0e;color:#e0e0e0;font-family:'Plus Jakarta Sans',sans-serif;min-height:100vh;display:flex;flex-direction:column}
      .container{max-width:900px;width:100%;margin:0 auto;padding:0 24px}
      header{border-bottom:1px solid #262626;background:rgba(14,14,14,.94);height:80px;display:flex;align-items:center}
      .header-content{display:flex;justify-content:space-between;align-items:center;gap:24px}
      .logo{font-family:'Newsreader',serif;font-size:24px;font-weight:700;color:#fff;text-decoration:none;white-space:nowrap}
      .dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:#22c55e;margin-right:8px}
      nav{display:flex;gap:20px;flex-wrap:wrap}
      nav a,footer a{color:#a3a3a3;text-decoration:none;font-size:13px}
      nav a:hover,footer a:hover{color:#fff}
      main{flex:1;padding-top:58px;padding-bottom:48px}
      .eyebrow{color:#22c55e;font-family:monospace;font-size:12px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px}
      h1,h2{font-family:'Newsreader',serif;color:#fff}
      h1{font-size:clamp(36px,6vw,48px);line-height:1.12;margin-bottom:20px}
      h2{font-size:25px;margin-bottom:14px}
      .lead{font-size:18px;line-height:1.8;color:#bdbdbd;margin-bottom:34px}
      .panel{background:#151515;border:1px solid #292929;border-radius:16px;padding:30px;margin:22px 0}
      p{font-size:15px;line-height:1.85;color:#bdbdbd}
      p+p{margin-top:14px}
      .email{display:inline-block;margin-top:18px;padding:14px 18px;border-radius:10px;background:#22c55e;color:#071107;text-decoration:none;font-weight:700;overflow-wrap:anywhere}
      .email:hover{background:#16a34a}
      .note{font-size:13px;color:#888;margin-top:20px}
      footer{border-top:1px solid #262626;padding:30px 0;text-align:center;color:#737373;font-size:12px}
      .footer-links{display:flex;justify-content:center;gap:20px;flex-wrap:wrap;margin-bottom:14px}
      @media(max-width:640px){header{height:auto;padding:20px 0}.header-content{align-items:flex-start;flex-direction:column}nav{gap:14px}main{padding-top:38px}.panel{padding:22px}}
    </style>
  </head>
  <body>
    <header>
      <div class="container header-content">
        <a href="/" class="logo"><span class="dot"></span>PromptVibe <span style="font-style:italic;font-weight:400;color:#a3a3a3">HQ</span></a>
        <nav aria-label="Main navigation">
          <a href="/">Home</a><a href="/prompts">All Prompts</a><a href="/about">About</a><a href="/privacy">Privacy</a><a href="/contact" aria-current="page">Contact</a>
        </nav>
      </div>
    </header>
    <main class="container">
      <div class="eyebrow">Contact</div>
      <h1>We’re here to hear from you.</h1>
      <p class="lead">Questions, corrections, feedback, or suggestions about PromptVibe HQ are welcome.</p>
      <section class="panel">
        <h2>Email us</h2>
        <p>For website questions, content corrections, copyright concerns, or general feedback, send us an email. Please describe the page or prompt you are referring to so we can understand your message.</p>
        <a class="email" href="mailto:support@promptvibehq.com">support@promptvibehq.com</a>
        <p class="note">Please do not include passwords, payment card details, or other sensitive personal information in your message.</p>
      </section>
      <section class="panel">
        <h2>What to include in your message</h2>
        <p>If your message concerns a specific page, include its URL and a short explanation of the issue. For privacy-related requests, write “Privacy request” in the subject line so we can identify the topic.</p>
      </section>
    </main>
    <footer>
      <div class="container">
        <div class="footer-links"><a href="/">Home</a><a href="/prompts">All Prompts</a><a href="/about">About</a><a href="/privacy">Privacy Policy</a><a href="/contact">Contact</a></div>
        <p>© {new Date().getFullYear()} PromptVibe HQ. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
