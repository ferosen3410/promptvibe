<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All AI Prompts Directory — PromptVibe HQ</title>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background-color: #0e0e0e; color: #e0e0e0; font-family: 'Plus Jakarta Sans', sans-serif; min-height: 100vh; display: flex; flex-direction: column; }
      .font-serif-title { font-family: 'Newsreader', serif; }
      .container { max-width: 1150px; margin: 0 auto; padding: 0 24px; width: 100%; }
      header { border-bottom: 1px solid #262626; background-color: rgba(14, 14, 14, 0.9); backdrop-filter: blur(8px); position: sticky; top: 0; z-index: 50; height: 80px; display: flex; align-items: center; }
      .header-content { display: flex; justify-content: space-between; align-items: center; width: 100%; }
      .logo { font-size: 24px; font-weight: 700; color: #fff; text-decoration: none; display: flex; align-items: center; gap: 8px; }
      .logo-dot { width: 12px; height: 12px; background-color: #22c55e; border-radius: 50%; display: inline-block; }
      nav { display: flex; align-items: center; gap: 24px; }
      nav a { color: #a3a3a3; text-decoration: none; font-size: 14px; }
      nav a:hover, nav a.active { color: #fff; }
      
      .hero { padding: 48px 0 24px 0; }
      h1 { font-size: 48px; font-weight: 400; color: #fff; margin-bottom: 12px; }
      .hero-p { font-size: 16px; color: #a3a3a3; }

      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px; margin: 32px 0 64px 0; }
      .card { background-color: rgba(23, 23, 23, 0.5); border: 1px solid #262626; border-radius: 16px; overflow: hidden; transition: all 0.2s; text-decoration: none; display: flex; flex-direction: column; }
      .card:hover { border-color: #22c55e; transform: translateY(-3px); }
      .card-img-wrapper { width: 100%; height: 200px; overflow: hidden; background-color: #171717; border-bottom: 1px solid #262626; }
      .card-img { width: 100%; height: 100%; object-fit: cover; }
      .card-body { padding: 24px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; }
      .category-tag { font-size: 12px; font-family: monospace; padding: 4px 12px; border-radius: 9999px; background-color: #262626; color: #22c55e; display: inline-block; margin-bottom: 12px; width: fit-content; }
      .card-title { font-size: 22px; color: #fff; margin-bottom: 12px; }
      .card-desc { color: #a3a3a3; font-size: 14px; font-weight: 300; line-height: 1.6; margin-bottom: 20px; }
      .btn-link { font-size: 13px; font-family: monospace; color: #22c55e; font-weight: 600; }

      footer { border-top: 1px solid #262626; margin-top: auto; padding: 40px 0; text-align: center; color: #737373; font-size: 12px; font-family: monospace; }
      .footer-links { display: flex; justify-content: center; gap: 24px; margin-bottom: 16px; }
      .footer-links a { color: #a3a3a3; text-decoration: none; }
    </style>
  </head>
  <body>
    
    <header>
      <div class="container header-content">
        <a href="/" class="logo font-serif-title">
          <span class="logo-dot"></span>
          PromptVibe<span style="font-style: italic; font-weight: 400; color: #a3a3a3;">HQ</span>
        </a>
        <nav>
          <a href="/prompts" class="active">All Prompts</a>
          <a href="/about">About</a>
          <a href="/privacy">Privacy Policy</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main class="container" style="flex-grow: 1;">
      <div class="hero">
        <h1 class="font-serif-title">Explore All AI Prompts</h1>
        <p class="hero-p">Click any prompt card to view visual samples, engineered parameters, and copyable commands.</p>
      </div>

      <div class="grid">
        {prompts.map((item) => (
          <a href={`/prompt/${item.slug}`} class="card">
            <div class="card-img-wrapper">
              <img src={item.image} alt={item.title} class="card-img" />
            </div>
            <div class="card-body">
              <div>
                <span class="category-tag">{item.category}</span>
                <h3 class="card-title font-serif-title">{item.title}</h3>
                <p class="card-desc">{item.description}</p>
              </div>
              <span class="btn-link">Read Guide & Copy Prompt →</span>
            </div>
          </a>
        ))}
      </div>
    </main>

    <footer>
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/prompts">All Prompts</a>
        <a href="/about">About Us</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/contact">Contact</a>
      </div>
      <p>© 2026 PromptVibe HQ. All rights reserved.</p>
    </footer>

  </body>
</html>