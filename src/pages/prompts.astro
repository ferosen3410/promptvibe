---
import Layout from '../layouts/Layout.astro';
import PromptCard from '../components/PromptCard.astro';
import { categories, prompts } from '../data/prompts';
---

<Layout
  title="All AI Prompts"
  description="Browse every prompt in the library: analysis, marketing, development, content, design and sales, each with a worked example and common mistakes."
>
  <section class="container article-head">
    <p class="crumbs"><a href="/">Home</a> / All prompts</p>
    <h1>All AI prompts</h1>
    <p class="lead muted" style="max-width:62ch">
      {prompts.length} prompts so far, each with a worked example, variations and the mistakes to avoid. Choose a category or search by keyword.
    </p>

    <div class="chips">
      {categories.map((c) => <a class="chip" href={`/category/${c.slug}`}>{c.name}</a>)}
    </div>

    <label class="sr-only" for="search" style="position:absolute;left:-9999px">Search prompts</label>
    <input class="search" id="search" type="search" placeholder="Search prompts, e.g. email, SQL, pricing" autocomplete="off" />

    <div class="grid" id="results">
      {prompts.map((entry) => <PromptCard entry={entry} />)}
    </div>
    <p class="empty-note" id="empty">No prompts match that search yet. Try a different word.</p>
  </section>
</Layout>

<script>
  const input = document.getElementById('search') as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#results .card'));
  const empty = document.getElementById('empty');

  function filter() {
    const q = (input?.value || '').trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const match = !q || (card.getAttribute('data-search') || '').includes(q);
      card.style.display = match ? '' : 'none';
      if (match) shown += 1;
    }
    if (empty) empty.style.display = shown === 0 ? 'block' : 'none';
  }

  input?.addEventListener('input', filter);
</script>
