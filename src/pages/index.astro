---
const prompts = [
  {
    title: "Karmaşık Belge Özetleme",
    category: "İş & Analiz",
    description: "Uzun makaleleri ve raporları 5 maddelik yönetici özetine dönüştürür.",
    prompt: "Kıdemli bir iş analisti olarak görev yap. Aşağıdaki metni analiz edin ve temel çıkarımları, önemli riskleri ve önerilen sonraki adımları özlü, 5 maddelik bir yönetici özetine dönüştürün:"
  },
  {
    title: "Soğuk E-Posta Satış Dizisi",
    category: "Pazarlama",
    description: "B2B SaaS ürünleri için yüksek dönüşümlü 3 adımlı e-posta dizisi hazırlar.",
    prompt: "Deneyimli bir metin yazarı gibi davranın. Pazarlama direktörlerini hedefleyen bir SaaS ürünü için 3 adımlı, kişiselleştirilmiş bir B2B soğuk e-posta dizisi yazın. Her birini 120 kelimenin altında tutun."
  },
  {
    title: "Kod Refaktörü & Optimizasyonu",
    category: "Yazılım",
    description: "Karmaşık ve performanssız kodları TypeScript en iyi pratikleriyle temizler.",
    prompt: "Kıdemli yazılım mühendisi rolünü üstlenin. Aşağıdaki kod parçasını inceleyin, performans darboğazlarını belirleyin ve temiz kod ilkeleri ve TypeScript en iyi uygulamalarını kullanarak yeniden yazın:"
  },
  {
    title: "SEO Uyumlu Blog Anahattı",
    category: "İçerik",
    description: "Google'da üst sıralara çıkacak detaylı ve H2/H3 yapılı içerik planı üretir.",
    prompt: "Uzman bir SEO stratejisti olarak davranın. [Konu] hakkında 2000 kelimelik bir blog yazısı için AIDA modelini kullanan, LSI anahtar kelimeleri içeren ve H2/H3 başlık yapısına sahip detaylı bir içerik taslağı oluşturun."
  },
  {
    title: "Midjourney Photorealistic Portre",
    category: "Görsel & Tasarım",
    description: "Sinematik, 8k çözünürlükte gerçekçi insan fotoğrafları oluşturmak için prompt.",
    prompt: "A realistic portrait photo of a 30-year-old architect, cinematic lighting, 85mm lens, f/1.8, highly detailed skin texture, professional studio background, hyperrealistic, 8k resolution --ar 16:9 --v 6.0"
  },
  {
    title: "Müşteri İtiraz Yönetimi",
    category: "Satış",
    description: "Fiyat ve zamanlama itirazlarını ikna edici şekilde yanıtlamanızı sağlar.",
    prompt: "Uzman bir B2B satış koçu olun. Potansiyel müşterinin 'Bütçemiz şu an için yetersiz' itirazına karşı kullanılabilecek, empati kuran ve değeri öne çıkaran 3 farklı ikna edici yanıt hazırlayın."
  }
];
---

<!DOCTYPE html>
<html lang="tr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PromptVibe HQ — Savaşta Test Edilmiş AI Prompt Kütüphanesi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              brand: {
                500: '#6366f1',
                600: '#4f46e5',
                accent: '#a855f7'
              }
            }
          }
        }
      }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white">
    
    <!-- Background Glow -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -right-40 w-96 h-96 bg-purple-600/20 rounded-full blur-3xl"></div>
    </div>

    <!-- Header / Navbar -->
    <header class="border-b border-slate-800/80 backdrop-blur-md bg-slate-950/70 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center font-black text-xl shadow-lg shadow-indigo-500/30">
            P
          </div>
          <span class="font-bold text-xl tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-200 to-slate-400">
            PromptVibe<span class="text-indigo-500">HQ</span>
          </span>
        </div>
        <nav class="flex items-center space-x-4">
          <a href="#" class="text-sm text-slate-400 hover:text-white transition">Kategoriler</a>
          <a href="#" class="text-sm text-slate-400 hover:text-white transition">Popüler</a>
          <a href="#" class="text-sm bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-4 py-2 rounded-lg transition shadow-md shadow-indigo-600/20">
            Prompt Gönder
          </a>
        </nav>
      </div>
    </header>

    <!-- Hero Section -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 mb-4">
          🚀 Üretime Hazır Yapay Zeka Komutları
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-tight mb-4">
          ChatGPT & Claude İş Akışlarınızı <br class="hidden sm:inline" />
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400">
            Işık Hızına Çıkarın
          </span>
        </h1>
        <p class="text-lg text-slate-400">
          Savaşta test edilmiş, direkt kopyalayıp kullanabileceğiniz profesyonel yapay zeka prompt kütüphanesi.
        </p>
      </div>

      <!-- Prompt Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {prompts.map((item) => (
          <div class="group relative bg-slate-900/60 border border-slate-800 rounded-2xl p-6 hover:border-indigo-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-indigo-500/10 flex flex-col justify-between backdrop-blur-sm">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-slate-800 text-indigo-400 border border-slate-700">
                  {item.category}
                </span>
              </div>
              <h3 class="text-xl font-bold text-white mb-2 group-hover:text-indigo-400 transition-colors">
                {item.title}
              </h3>
              <p class="text-slate-400 text-sm mb-4 leading-relaxed">
                {item.description}
              </p>
            </div>

            <div class="mt-4 pt-4 border-t border-slate-800/80">
              <div class="bg-slate-950 rounded-xl p-3 text-xs text-slate-300 font-mono mb-4 border border-slate-800/60 line-clamp-3 select-all">
                {item.prompt}
              </div>
              <button
                onclick={`navigator.clipboard.writeText(\`${item.prompt.replace(/`/g, '\\`')}\`); this.innerText = 'Kopyalandı! 🎉'; setTimeout(() => this.innerText = 'Promptu Kopyala 📋', 2000);`}
                class="w-full py-2.5 px-4 bg-slate-800 hover:bg-indigo-600 text-white font-medium text-sm rounded-xl transition-all duration-200 flex items-center justify-center space-x-2 border border-slate-700/50 hover:border-transparent active:scale-[0.98]"
              >
                <span>Promptu Kopyala 📋</span>
              </button>
            </div>
          </div>
        ))}
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 mt-16 py-8 text-center text-slate-500 text-sm">
      <p>© 2026 PromptVibe HQ. Tüm hakları saklıdır.</p>
    </footer>

  </body>
</html>