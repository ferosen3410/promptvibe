---
const prompts = [
  {
    title: "Karmaşık Belge Özetleme",
    category: "İş & Analiz",
    description: "Uzun makaleleri ve raporları 5 maddelik yönetici özetine dönüştürür.",
    prompt: "Kıdemli bir iş analisti olarak görev yap. Aşağıdaki metni analiz edin ve temel çıkarımları, önemli riskleri ve önerilen sonraki adımları özlü, 5 maddelik bir yönetici özetine dönüştürün:"
  },
  {
    title: "Soğuk E-Posta Satış Dizisi",
    category: "Pazarlama",
    description: "B2B SaaS ürünleri için yüksek dönüşümlü 3 adımlı e-posta dizisi hazırlar.",
    prompt: "Deneyimli bir metin yazarı gibi davranın. Pazarlama direktörlerini hedefleyen bir SaaS ürünü için 3 adımlı, kişiselleştirilmiş bir B2B soğuk e-posta dizisi yazın. Her birini 120 kelimenin altında tutun."
  },
  {
    title: "Kod Refaktörü & Optimizasyonu",
    category: "Yazılım",
    description: "Karmaşık ve performanssız kodları TypeScript en iyi pratikleriyle temizler.",
    prompt: "Kıdemli yazılım mühendisi rolünü üstlenin. Aşağıdaki kod parçasını inceleyin, performans darboğazlarını belirleyin ve temiz kod ilkeleri ve TypeScript en iyi uygulamalarını kullanarak yeniden yazın:"
  },
  {
    title: "SEO Uyumlu Blog Anahattı",
    category: "İçerik",
    description: "Google'da üst sıralara çıkacak detaylı ve H2/H3 yapılı içerik planı üretir.",
    prompt: "Uzman bir SEO stratejisti olarak davranın. [Konu] hakkında 2000 kelimelik bir blog yazısı için AIDA modelini kullanan, LSI anahtar kelimeleri içeren ve H2/H3 başlık yapısına sahip detaylı bir içerik taslağı oluşturun."
  },
  {
    title: "Midjourney Photorealistic Portre",
    category: "Görsel & Tasarım",
    description: "Sinematik, 8k çözünürlükte gerçekçi insan fotoğrafları oluşturmak için prompt.",
    prompt: "A realistic portrait photo of a 30-year-old architect, cinematic lighting, 85mm lens, f/1.8, highly detailed skin texture, professional studio background, hyperrealistic, 8k resolution --ar 16:9 --v 6.0"
  },
  {
    title: "Müşteri İtiraz Yönetimi",
    category: "Satış",
    description: "Fiyat ve zamanlama itirazlarını ikna edici şekilde yanıtlamanızı sağlar.",
    prompt: "Uzman bir B2B satış koçu olun. Potansiyel müşterinin 'Bütçemiz şu an için yetersiz' itirazına karşı kullanılabilecek, empati kuran ve değeri öne çıkaran 3 farklı ikna edici yanıt hazırlayın."
  }
];
---

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PromptVibe HQ — Savaşta Test Edilmiş AI Prompt Kütüphanesi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        background-color: #0e0e0e;
        color: #e0e0e0;
        font-family: 'Plus Jakarta Sans', sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .font-serif-title {
        font-family: 'Newsreader', serif;
      }
      .container {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 24px;
        width: 100%;
      }
      header {
        border-bottom: 1px solid #262626;
        background-color: rgba(14, 14, 14, 0.9);
        backdrop-filter: blur(8px);
        position: sticky;
        top: 0;
        z-index: 50;
        height: 80px;
        display: flex;
        align-items: center;
      }
      .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .logo {
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .logo-dot {
        width: 12px;
        height: 12px;
        background-color: #22c55e;
        border-radius: 50%;
        display: inline-block;
      }
      nav {
        display: flex;
        align-items: center;
        gap: 24px;
      }
      nav a {
        color: #a3a3a3;
        text-decoration: none;
        font-size: 14px;
        transition: color 0.2s;
      }
      nav a:hover {
        color: #fff;
      }
      .btn-primary {
        background-color: #fff;
        color: #000;
        padding: 10px 20px;
        border-radius: 9999px;
        font-weight: 500;
        text-decoration: none;
        transition: background-color 0.2s;
      }
      .btn-primary:hover {
        background-color: #e5e5e5;
      }
      .hero {
        padding: 64px 0;
        border-bottom: 1px solid #262626;
        margin-bottom: 64px;
        display: flex;
        flex-direction: column;
        gap: 24px;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 4px 12px;
        border-radius: 9999px;
        font-size: 12px;
        font-family: monospace;
        background-color: #171717;
        border: 1px solid #262626;
        color: #22c55e;
        width: fit-content;
      }
      h1 {
        font-size: 56px;
        font-weight: 400;
        line-height: 1.1;
        color: #fff;
        letter-spacing: -1px;
      }
      h1 span {
        font-style: italic;
        color: #a3a3a3;
      }
      .hero-p {
        font-size: 18px;
        color: #a3a3a3;
        font-weight: 300;
        max-w: 600px;
        line-height: 1.6;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 32px;
      }
      .card {
        background-color: rgba(23, 23, 23, 0.5);
        border: 1px solid #262626;
        border-radius: 16px;
        padding: 28px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: border-color 0.2s;
      }
      .card:hover {
        border-color: #404040;
      }
      .category-tag {
        font-size: 12px;
        font-family: monospace;
        padding: 4px 12px;
        border-radius: 9999px;
        background-color: #262626;
        color: #d4d4d4;
        display: inline-block;
        margin-bottom: 16px;
      }
      .card-title {
        font-size: 24px;
        color: #fff;
        margin-bottom: 12px;
      }
      .card-desc {
        color: #a3a3a3;
        font-size: 14px;
        font-weight: 300;
        line-height: 1.6;
        margin-bottom: 24px;
      }
      .prompt-box {
        background-color: #080808;
        border: 1px solid #262626;
        border-radius: 12px;
        padding: 16px;
        font-size: 12px;
        color: #d4d4d4;
        font-family: monospace;
        line-height: 1.6;
        margin-bottom: 16px;
        max-height: 120px;
        overflow-y: auto;
      }
      .copy-btn {
        width: 100%;
        padding: 12px;
        background-color: #262626;
        color: #fff;
        border: none;
        border-radius: 12px;
        font-weight: 500;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .copy-btn:hover {
        background-color: #22c55e;
        color: #000;
      }
      footer {
        border-top: 1px solid #262626;
        margin-top: 80px;
        padding: 40px 0;
        text-align: center;
        color: #737373;
        font-size: 12px;
        font-family: monospace;
      }
    </style>
  </head>
  <body>
    
    <!-- Navbar -->
    <header>
      <div class="container header-content">
        <a href="/" class="logo font-serif-title">
          <span class="logo-dot"></span>
          PromptVibe<span style="font-style: italic; font-weight: 400; color: #a3a3a3;">HQ</span>
        </a>
        <nav>
          <a href="#">Kategoriler</a>
          <a href="#">Popüler</a>
          <a href="#" class="btn-primary">Prompt Gönder</a>
        </nav>
      </div>
    </header>

    <!-- Hero Section -->
    <main class="container" style="flex-grow: 1;">
      <div class="hero">
        <div class="badge">
          <span>●</span> %100 Ücretsiz Kütüphane
        </div>
        <h1 class="font-serif-title">
          Human prompts <br />
          <span>& AI engineering.</span>
        </h1>
        <p class="hero-p">
          ChatGPT, Claude ve Midjourney için mühendislik standartlarında hazırlanmış, üretime hazır yapay zeka komutları kütüphanesi.
        </p>
      </div>

      <!-- Prompt Grid -->
      <div class="grid">
        {prompts.map((item) => (
          <div class="card">
            <div>
              <div>
                <span class="category-tag">{item.category}</span>
              </div>
              <h3 class="card-title font-serif-title">{item.title}</h3>
              <p class="card-desc">{item.description}</p>
            </div>

            <div>
              <div class="prompt-box">{item.prompt}</div>
              <button
                class="copy-btn"
                onclick={`navigator.clipboard.writeText(\`${item.prompt.replace(/`/g, '\\`')}\`); this.innerText = 'Kopyalandı! ✓'; setTimeout(() => this.innerText = 'Promptu Kopyala 📋', 2000);`}
              >
                Promptu Kopyala 📋
              </button>
            </div>
          </div>
        ))}
      </div>
    </main>

    <!-- Footer -->
    <footer>
      <p>© 2026 PromptVibe HQ. Tüm hakları saklıdır.</p>
    </footer>

  </body>
</html>