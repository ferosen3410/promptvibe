---

<!DOCTYPE html>
<html lang="tr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PromptVibe HQ — Savaşta Test Edilmiş AI Komutları</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts for Editorial Aesthetics -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: {
              serif: ['Newsreader', 'Georgia', 'serif'],
              sans: ['Plus Jakarta Sans', 'sans-serif'],
            },
            colors: {
              brand: {
                black: '#0A0A0A',
                card: '#121212',
                accent: '#22c55e', // Medium style neon green
                hover: '#16a34a'
              }
            }
          }
        }
      }
    </script>
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: #0A0A0A;
        color: #E5E7EB;
      }
      .font-serif-title {
        font-family: 'Newsreader', Georgia, serif;
      }
      /* Custom Scrollbar for chips */
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col selection:bg-green-500 selection:text-black antialiased">

    <header class="border-b border-neutral-800/80 bg-brand-black/90 sticky top-0 z-50 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center space-x-3 group">
          <span class="font-serif-title font-bold text-3xl tracking-tight text-white group-hover:text-green-500 transition-colors">
            PromptVibe<span class="text-green-500">HQ</span>
          </span>
        </a>
        
        <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-neutral-400">
          <a href="#prompts" class="hover:text-white transition">Kategoriler</a>
          <a href="#prompts" class="hover:text-white transition">Popüler</a>
          <a href="#about" class="hover:text-white transition">Hakkında</a>
          <a href="#" class="hover:text-white transition">Giriş Yap</a>
        </nav>

        <div class="flex items-center space-x-4">
          <a href="#prompts" class="bg-white hover:bg-neutral-200 text-black font-semibold text-sm px-5 py-2.5 rounded-full transition duration-200">
            Başla & Keşfet
          </a>
        </div>
      </div>
    </header>

    <section class="border-b border-neutral-800 bg-brand-black text-white relative overflow-hidden py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Hero Text -->
        <div class="lg:col-span-7 space-y-6">
          <h1 class="font-serif-title text-5xl sm:text-7xl font-normal tracking-tight leading-[1.08] text-white">
            Human prompts <br />
            <span class="italic font-light text-green-500">& AI engineering.</span>
          </h1>
          
          <p class="text-lg md:text-xl text-neutral-400 max-w-xl font-normal leading-relaxed">
            ChatGPT, Claude ve Midjourney için mühendislik standartlarında hazırlanmış, savaşta test edilmiş yapay zeka komutları kütüphanesi.
          </p>

          <div class="pt-4 flex flex-wrap gap-4 items-center">
            <a href="#prompts" class="bg-green-500 hover:bg-green-600 text-black font-bold px-8 py-3.5 rounded-full text-base transition duration-200 shadow-lg shadow-green-500/10">
              Promptları Keşfet
            </a>
            <span class="text-sm text-neutral-500">Kayıt olmadan %100 Ücretsiz</span>
          </div>
        </div>

        <!-- Medium-inspired Vector Illustration Art -->
        <div class="lg:col-span-5 relative flex justify-center items-center">
          <div class="w-full max-w-md h-80 relative flex items-center justify-center">
            <!-- Flower/Aesthetic Art Vector -->
            <svg class="w-72 h-72 text-green-500 opacity-90 animate-pulse" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
              <path fill="currentColor" d="M44.7,-76.4C58.8,-69.2,71.8,-59.1,79.6,-45.8C87.4,-32.6,90,-16.3,88.5,-0.9C87.1,14.6,81.6,29.2,73.1,41.8C64.6,54.4,53,65,39.6,72.4C26.1,79.8,10.8,84,-4.1,86.5C-19,89,-33.8,89.8,-46.8,83.1C-59.8,76.4,-71,62.2,-78.3,46.7C-85.6,31.2,-89,14.4,-87.3,-1.7C-85.6,-17.8,-78.8,-33.2,-68.9,-45.4C-59,-57.6,-46,-66.6,-32.7,-74.3C-19.4,-82,-5.8,-88.4,7.1,-87.9C20,-87.4,20.6,-83.6,44.7,-76.4Z" transform="translate(100 100)" />
            </svg>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="font-serif-title italic text-4xl text-black font-bold">PromptVibe</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <section id="prompts" class="max-w-7xl mx-auto px-6 py-10 w-full flex-grow">
      
      <!-- Search Bar -->
      <div class="mb-8 max-w-2xl">
        <div class="relative">
          <input
            type="text"
            id="searchInput"
            placeholder="Prompt ara (Örn: SEO, E-posta, TypeScript, Midjourney)..."
            class="w-full bg-brand-card border border-neutral-800 text-white rounded-full py-4 pl-12 pr-4 focus:outline-none focus:border-green-500 transition duration-200 text-sm"
          />
          <svg class="w-5 h-5 text-neutral-500 absolute left-4 top-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>

      <!-- Categories Navigation Chips -->
      <div class="flex items-center space-x-2 overflow-x-auto no-scrollbar pb-6 border-b border-neutral-800/80 mb-10" id="categoryChips">
        <button class="category-btn active px-4 py-2 rounded-full text-xs font-semibold bg-green-500 text-black whitespace-nowrap transition" data-category="Tümü">Tümü</button>
        <button class="category-btn px-4 py-2 rounded-full text-xs font-semibold bg-neutral-900 hover:bg-neutral-800 text-neutral-300 border border-neutral-800 whitespace-nowrap transition" data-category="İş & Analiz">İş & Analiz</button>
        <button class="category-btn px-4 py-2 rounded-full text-xs font-semibold bg-neutral-900 hover:bg-neutral-800 text-neutral-300 border border-neutral-800 whitespace-nowrap transition" data-category="Pazarlama">Pazarlama</button>
        <button class="category-btn px-4 py-2 rounded-full text-xs font-semibold bg-neutral-900 hover:bg-neutral-800 text-neutral-300 border border-neutral-800 whitespace-nowrap transition" data-category="Yazılım">Yazılım</button>
        <button class="category-btn px-4 py-2 rounded-full text-xs font-semibold bg-neutral-900 hover:bg-neutral-800 text-neutral-300 border border-neutral-800 whitespace-nowrap transition" data-category="SEO">SEO</button>
        <button class="category-btn px-4 py-2 rounded-full text-xs font-semibold bg-neutral-900 hover:bg-neutral-800 text-neutral-300 border border-neutral-800 whitespace-nowrap transition" data-category="Görsel & Tasarım">Görsel & Tasarım</button>
        <button class="category-btn px-4 py-2 rounded-full text-xs font-semibold bg-neutral-900 hover:bg-neutral-800 text-neutral-300 border border-neutral-800 whitespace-nowrap transition" data-category="Satış">Satış</button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="promptGrid">
        {prompts.map((item) => (
          <article class="prompt-card bg-brand-card border border-neutral-800/90 rounded-2xl p-6 flex flex-col justify-between hover:border-neutral-600 transition-all duration-300 group" data-category={item.category} data-title={item.title.toLowerCase()} data-prompt={item.prompt.toLowerCase()}>
            
            <div>
              <!-- Meta Info Header -->
              <div class="flex items-center justify-between text-xs text-neutral-500 mb-3">
                <span class="text-green-500 font-semibold uppercase tracking-wider">{item.category}</span>
                <span>{item.readTime}</span>
              </div>

              <!-- Card Title -->
              <h2 class="font-serif-title text-2xl font-bold text-white mb-3 group-hover:text-green-400 transition-colors">
                {item.title}
              </h2>

              <!-- Description -->
              <p class="text-neutral-400 text-sm leading-relaxed mb-6 font-normal">
                {item.description}
              </p>
            </div>

            <!-- Prompt Box & Action -->
            <div class="pt-4 border-t border-neutral-800/80">
              <div class="bg-black/80 rounded-xl p-3 text-xs text-neutral-300 font-mono mb-4 border border-neutral-800 line-clamp-3 select-all">
                {item.prompt}
              </div>

              <div class="flex items-center justify-between gap-3">
                <button
                  class="copy-btn flex-grow py-2.5 px-4 bg-neutral-900 hover:bg-green-500 hover:text-black text-white font-semibold text-xs rounded-xl transition duration-200 border border-neutral-800 flex items-center justify-center space-x-2"
                  data-prompt={item.prompt}
                >
                  <span>Promptu Kopyala 📋</span>
                </button>
                <div class="flex items-center text-xs text-neutral-500 space-x-1 px-2">
                  <span>❤️</span>
                  <span>{item.likes}</span>
                </div>
              </div>
            </div>

          </article>
        ))}
      </div>

      <div id="noResults" class="hidden text-center py-16 text-neutral-500">
        <p class="text-lg">Aradığınız kriterlere uygun prompt bulunamadı.</p>
      </div>
    </section>

    <div id="toast" class="fixed bottom-6 right-6 bg-green-500 text-black font-bold px-6 py-3 rounded-xl shadow-2xl transition-all duration-300 transform translate-y-20 opacity-0 z-50 flex items-center space-x-2">
      <span>🎉</span>
      <span id="toastMessage">Prompt panoya kopyalandı!</span>
    </div>

    <footer id="about" class="border-t border-neutral-800 bg-brand-black py-12 text-center text-neutral-500 text-sm">
      <div class="max-w-7xl mx-auto px-6 space-y-4">
        <p class="font-serif-title text-xl text-white">PromptVibe HQ</p>
        <p class="max-w-md mx-auto text-xs text-neutral-500">Yapay zeka modelleri için yüksek kaliteli, optimize edilmiş ve doğrulanmış komut kütüphanesi.</p>
        <p class="text-xs pt-4">© 2026 PromptVibe HQ. Tüm hakları saklıdır.</p>
      </div>
    </footer>

    <script>
      // Interactive Filtering & Search Logic
      const searchInput = document.getElementById('searchInput');
      const categoryChips = document.querySelectorAll('.category-btn');
      const promptCards = document.querySelectorAll('.prompt-card');
      const noResults = document.getElementById('noResults');
      const toast = document.getElementById('toast');

      let currentCategory = 'Tümü';

      function filterPrompts() {
        const query = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;

        promptCards.forEach(card => {
          const category = card.getAttribute('data-category');
          const title = card.getAttribute('data-title');
          const promptText = card.getAttribute('data-prompt');

          const matchesCategory = currentCategory === 'Tümü' || category === currentCategory;
          const matchesSearch = title.includes(query) || promptText.includes(query);

          if (matchesCategory && matchesSearch) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }

      // Search input handler
      searchInput?.addEventListener('input', filterPrompts);

      // Category chip handler
      categoryChips.forEach(chip => {
        chip.addEventListener('click', () => {
          categoryChips.forEach(c => {
            c.classList.remove('bg-green-500', 'text-black');
            c.classList.add('bg-neutral-900', 'text-neutral-300');
          });

          chip.classList.remove('bg-neutral-900', 'text-neutral-300');
          chip.classList.add('bg-green-500', 'text-black');

          currentCategory = chip.getAttribute('data-category') || 'Tümü';
          filterPrompts();
        });
      });

      // Copy Prompt functionality with Toast Feedback
      document.querySelectorAll('.copy-btn').forEach(button => {
        button.addEventListener('click', (e) => {
          const promptText = button.getAttribute('data-prompt');
          if (promptText) {
            navigator.clipboard.writeText(promptText).then(() => {
              // Show Toast
              toast.classList.remove('translate-y-20', 'opacity-0');
              setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
              }, 2500);
            });
          }
        });
      });
    </script>
  </body>
</html>