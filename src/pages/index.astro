---
import Layout from '../layouts/Layout.astro';
import PromptCard from '../components/PromptCard.astro';
import { SITE } from '../data/site';
import { categories, prompts, promptsByCategory } from '../data/prompts';

const latest = prompts.slice(0, 6);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};
---

<Layout
  title="Free AI Prompt Library With Worked Examples"
  description={SITE.description}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Free AI prompt library</p>
      <h1>Prompts with the reasoning left in.</h1>
      <p class="lead">
        Every prompt here comes with a worked example, variations for different situations and the mistakes that most often
        ruin the result, so you understand what you are copying and can adapt it.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/prompts">Browse all prompts</a>
        <a class="btn ghost" href="/about">How this library works</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Browse by category</h2>
      </div>
      <div class="grid">
        {categories.map((c) => (
          <a class="hub" href={`/category/${c.slug}`}>
            <h3>{c.name}</h3>
            <p>{c.blurb}</p>
            <p class="count">{promptsByCategory(c.slug).length} {promptsByCategory(c.slug).length === 1 ? 'prompt' : 'prompts'}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Latest prompts</h2>
        <a href="/prompts">See all {prompts.length} prompts</a>
      </div>
      <div class="grid">
        {latest.map((entry) => <PromptCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 style="margin-top:0">What you get on every prompt page</h2>
      <div class="three-col">
        <div>
          <h3>A prompt you can read</h3>
          <p class="muted">Variables are named and explained, so you know exactly which parts to change and which to leave alone.</p>
        </div>
        <div>
          <h3>A worked example</h3>
          <p class="muted">A sample input and output that shows the format and level of detail to expect from the prompt.</p>
        </div>
        <div>
          <h3>Variations and pitfalls</h3>
          <p class="muted">Adjustments for other situations, plus the common mistakes that make results vague or wrong.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>