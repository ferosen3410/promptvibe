---
const prompts = [
  {
    title: "Karmaşık Belge Özetleme",
    category: "İş & Analiz",
    description: "Uzun makaleleri ve raporları 5 maddelik yönetici özetine dönüştürür.",
    prompt: "Kıdemli bir iş analisti olarak görev yap. Aşağıdaki metni analiz edin ve temel çıkarımları, önemli riskleri ve önerilen sonraki adımları özlü, 5 maddelik bir yönetici özetine dönüştürün:"
  },
  {
    title: "Soğuk E-Posta Satış Dizisi",
    category: "Pazarlama",
    description: "B2B SaaS ürünleri için yüksek dönüşümlü 3 adımlı e-posta dizisi hazırlar.",
    prompt: "Deneyimli bir metin yazarı gibi davranın. Pazarlama direktörlerini hedefleyen bir SaaS ürünü için 3 adımlı, kişiselleştirilmiş bir B2B soğuk e-posta dizisi yazın. Her birini 120 kelimenin altında tutun."
  },
  {
    title: "Kod Refaktörü & Optimizasyonu",
    category: "Yazılım",
    description: "Karmaşık ve performanssız kodları TypeScript en iyi pratikleriyle temizler.",
    prompt: "Kıdemli yazılım mühendisi rolünü üstlenin. Aşağıdaki kod parçasını inceleyin, performans darboğazlarını belirleyin ve temiz kod ilkeleri ve TypeScript en iyi uygulamalarını kullanarak yeniden yazın:"
  },
  {
    title: "SEO Uyumlu Blog Anahattı",
    category: "İçerik",
    description: "Google'da üst sıralara çıkacak detaylı ve H2/H3 yapılı içerik planı üretir.",
    prompt: "Uzman bir SEO stratejisti olarak davranın. [Konu] hakkında 2000 kelimelik bir blog yazısı için AIDA modelini kullanan, LSI anahtar kelimeleri içeren ve H2/H3 başlık yapısına sahip detaylı bir içerik taslağı oluşturun."
  },
  {
    title: "Midjourney Photorealistic Portre",
    category: "Görsel & Tasarım",
    description: "Sinematik, 8k çözünürlükte gerçekçi insan fotoğrafları oluşturmak için prompt.",
    prompt: "A realistic portrait photo of a 30-year-old architect, cinematic lighting, 85mm lens, f/1.8, highly detailed skin texture, professional studio background, hyperrealistic, 8k resolution --ar 16:9 --v 6.0"
  },
  {
    title: "Müşteri İtiraz Yönetimi",
    category: "Satış",
    description: "Fiyat ve zamanlama itirazlarını ikna edici şekilde yanıtlamanızı sağlar.",
    prompt: "Uzman bir B2B satış koçu olun. Potansiyel müşterinin 'Bütçemiz şu an için yetersiz' itirazına karşı kullanılabilecek, empati kuran ve değeri öne çıkaran 3 farklı ikna edici yanıt hazırlayın."
  }
];
---

<!DOCTYPE html>
<html lang="tr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PromptVibe HQ — Savaşta Test Edilmiş AI Prompt Kütüphanesi</title>
    <!-- Tailwind CSS Direct CDN (Garantili Stil Yükleme) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
      .font-serif-title {
        font-family: 'Newsreader', serif;
      }
    </style>
  </head>
  <body class="bg-[#0e0e0e] text-[#e0e0e0] min-h-screen flex flex-col selection:bg-[#22c55e] selection:text-black">
    
    <!-- Navbar -->
    <header class="border-b border-neutral-800 bg-[#0e0e0e]/90 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href="/" class="text-2xl font-serif-title font-bold tracking-tight text-white flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#22c55e]"></span>
          PromptVibe<span class="italic font-normal text-neutral-400">HQ</span>
        </a>
        <nav class="flex items-center space-x-6 text-sm">
          <a href="#" class="text-neutral-400 hover:text-white transition-colors">Kategoriler</a>
          <a href="#" class="text-neutral-400 hover:text-white transition-colors">Popüler</a>
          <a href="#" class="bg-white text-black font-medium px-5 py-2.5 rounded-full hover:bg-neutral-200 transition-all">
            Prompt Gönder
          </a>
        </nav>
      </div>
    </header>

    <!-- Hero Section -->
    <main class="flex-grow max-w-6xl w-full mx-auto px-6 py-16">
      <div class="border-b border-neutral-800 pb-16 mb-16 flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-neutral-900 border border-neutral-800 text-[#22c55e] mb-6">
            <span>●</span> %100 Ücretsiz Kütüphane
          </div>
          <h1 class="text-5xl sm:text-6xl font-serif-title font-normal tracking-tight text-white leading-[1.1] mb-6">
            Human prompts <br />
            <span class="italic text-neutral-400">& AI engineering.</span>
          </h1>
          <p class="text-lg text-neutral-400 font-light leading-relaxed">
            ChatGPT, Claude ve Midjourney için mühendislik standartlarında hazırlanmış, üretime hazır yapay zeka komutları kütüphanesi.
          </p>
        </div>
        <div>
          <a href="#prompts" class="inline-flex items-center gap-2 text-sm font-mono text-[#22c55e] hover:underline">
            Tüm Komutları Keşfet ↓
          </a>
        </div>
      </div>

      <!-- Prompt Grid -->
      <div id="prompts" class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {prompts.map((item) => (
          <div class="bg-neutral-900/50 border border-neutral-800 rounded-2xl p-7 hover:border-neutral-700 transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-mono px-3 py-1 rounded-full bg-neutral-800 text-neutral-300">
                  {item.category}
                </span>
              </div>
              <h3 class="text-2xl font-serif-title text-white mb-3 group-hover:text-[#22c55e] transition-colors">
                {item.title}
              </h3>
              <p class="text-neutral-400 text-sm font-light mb-6 leading-relaxed">
                {item.description}
              </p>
            </div>

            <div>
              <div class="bg-[#080808] rounded-xl p-4 text-xs text-neutral-300 font-mono mb-4 border border-neutral-800/80 leading-relaxed max-h-32 overflow-y-auto">
                {item.prompt}
              </div>
              <button
                onclick={`navigator.clipboard.writeText(\`${item.prompt.replace(/`/g, '\\`')}\`); this.innerText = 'Kopyalandı! ✓'; setTimeout(() => this.innerText = 'Promptu Kopyala 📋', 2000);`}
                class="w-full py-3 px-4 bg-neutral-800 hover:bg-[#22c55e] hover:text-black text-white font-medium text-sm rounded-xl transition-all duration-200 flex items-center justify-center space-x-2 active:scale-[0.99]"
              >
                <span>Promptu Kopyala 📋</span>
              </button>
            </div>
          </div>
        ))}
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-neutral-800 mt-20 py-10 text-center text-neutral-500 text-xs font-mono">
      <p>© 2026 PromptVibe HQ. All rights reserved.</p>
    </footer>

  </body>
</html>