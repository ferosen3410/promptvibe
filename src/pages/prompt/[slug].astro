---
import Layout from '../../layouts/Layout.astro';
import Cover from '../../components/Cover.astro';
import PromptCard from '../../components/PromptCard.astro';
import { SITE } from '../../data/site';
import { prompts, getCategory, relatedPrompts, readMinutes, formatDate, type PromptEntry } from '../../data/prompts';

export function getStaticPaths() {
  return prompts.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: PromptEntry;
}

const { entry } = Astro.props;
const category = getCategory(entry.category);
const minutes = readMinutes(entry);
const related = relatedPrompts(entry, 3);
const url = `${SITE.url}/prompt/${entry.slug}`;
const authorName = SITE.author.name.trim();
const initial = authorName.startsWith('[') ? 'P' : (authorName[0] || 'P').toUpperCase();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.title,
    description: entry.summary,
    datePublished: entry.published,
    dateModified: entry.reviewed,
    mainEntityOfPage: url,
    author: { '@type': 'Person', name: SITE.author.name },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: category.name, item: `${SITE.url}/category/${category.slug}` },
      { '@type': 'ListItem', position: 3, name: entry.title, item: url },
    ],
  },
];
---

<Layout title={entry.metaTitle} description={entry.summary} type="article" jsonLd={jsonLd}>
  <article class="narrow article-head prose">
    <p class="crumbs">
      <a href="/">Home</a> / <a href={`/category/${category.slug}`}>{category.name}</a> / {entry.title}
    </p>
    <a class="chip" href={`/category/${category.slug}`}>{category.name}</a>
    <h1>{entry.title}</h1>
    <p class="lead muted">{entry.summary}</p>
    <p class="meta">
      {minutes} min read &middot; Published {formatDate(entry.published)} &middot; Last reviewed {formatDate(entry.reviewed)}
    </p>

    <div class="hero-cover">
      <Cover category={entry.category} seed={entry.slug} label={`Illustration for ${entry.title}`} />
    </div>

    {entry.intro.map((para) => <p>{para}</p>)}

    <h2>The prompt</h2>
    <div class="promptbox">
      <div class="promptbox-head">
        <span>Copy and paste</span>
        <button type="button" class="btn copy-btn" data-copy="prompt-text">Copy prompt</button>
      </div>
      <pre id="prompt-text">{entry.prompt}</pre>
    </div>

    <h3>What to replace</h3>
    <div class="table-wrap">
      <table class="var-table">
        <thead>
          <tr><th>Variable</th><th>What to put there</th></tr>
        </thead>
        <tbody>
          {entry.variables.map((v) => (
            <tr><td><code>{v.name}</code></td><td>{v.hint}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>How to use it</h2>
    <ol>
      {entry.steps.map((s) => <li>{s}</li>)}
    </ol>

    <h2>Worked example</h2>
    <p class="notice">
      This example was written for this page to show the format. Results from your own model and your own material will differ, so run the prompt yourself before relying on it.
    </p>
    <div class="example">
      <div class="example-block">
        <h3>Input</h3>
        <pre>{entry.example.input}</pre>
      </div>
      <div class="example-block">
        <h3>Output</h3>
        <pre>{entry.example.output}</pre>
      </div>
    </div>

    <h2>Variations</h2>
    <div class="table-wrap">
      <table class="var-table">
        <thead>
          <tr><th>Situation</th><th>What to change</th></tr>
        </thead>
        <tbody>
          {entry.variations.map((v) => (
            <tr><td>{v.situation}</td><td>{v.change}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Common mistakes</h2>
    <ul>
      {entry.mistakes.map((m) => <li><strong>{m.title}.</strong> {m.detail}</li>)}
    </ul>

    <h2>Frequently asked questions</h2>
    <div class="faq">
      {entry.faq.map((f) => (
        <>
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </>
      ))}
    </div>

    <aside class="author-box" aria-label="About the author">
      <div class="avatar" aria-hidden="true">{initial}</div>
      <p>
        <strong>{SITE.author.name}</strong>, {SITE.author.role}. Questions or corrections about this prompt?
        <a href="/contact">Get in touch</a> and the page will be updated with a new review date.
      </p>
    </aside>
  </article>

  <section class="container section">
    <div class="section-head"><h2 style="margin-top:0">More prompts</h2></div>
    <div class="grid">
      {related.map((r) => <PromptCard entry={r} />)}
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const target = document.getElementById(btn.dataset.copy || '');
      if (!target) return;
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(target.textContent || '');
        btn.textContent = 'Copied';
      } catch {
        const range = document.createRange();
        range.selectNodeContents(target);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        btn.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => {
        btn.textContent = original;
      }, 2000);
    });
  });
</script>
