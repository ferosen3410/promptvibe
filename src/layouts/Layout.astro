---
import '../styles/global.css';
import { SITE, NAV, FOOTER_LINKS, SOCIAL_LINKS } from '../data/site';
import { categories } from '../data/prompts';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, type = 'website', jsonLd, noindex = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = `${SITE.url}${path === '/' ? '' : path}`;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const year = new Date().getFullYear();
const current = path;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#15171f" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    {schemas.map((s) => <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />)}

    {SITE.adsensePublisherId && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsensePublisherId}`}
        crossorigin="anonymous"
      ></script>
    )}
    {SITE.analyticsId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analyticsId}`}></script>}
    {SITE.analyticsId && (
      <script
        is:inline
        set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${SITE.analyticsId}');`}
      />
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href="/" aria-label={`${SITE.name} home`}>
          <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
            <rect width="32" height="32" rx="9" fill="var(--brand)"></rect>
            <path d="M9 21 L16 9 L23 21" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
            <circle cx="16" cy="22" r="2.4" fill="var(--accent)"></circle>
          </svg>
          <span>{SITE.name}</span>
        </a>
        <nav aria-label="Main">
          <ul class="nav">
            {NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={current === item.href || current.startsWith(`${item.href}/`) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <p class="footer-title">{SITE.name}</p>
          <p class="muted small">{SITE.tagline}.</p>
        </div>
        <div>
          <p class="footer-title">Browse</p>
          <ul class="footer-list">
            {categories.map((c) => (
              <li><a href={`/category/${c.slug}`}>{c.name}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="footer-title">Site</p>
          <ul class="footer-list">
            {FOOTER_LINKS.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="footer-title">Socials</p>
          <ul class="footer-list">
            {SOCIAL_LINKS.map((s) => (
              <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.name}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="container footer-bottom">
        <p class="muted small">&copy; {year} {SITE.name}. Prompts are free to use. AI output can contain mistakes, so always review it before relying on it.</p>
      </div>
    </footer>

    <!-- Cookie Consent Banner -->
    <div id="cookie-banner" class="fixed bottom-4 left-4 right-4 md:left-auto md:right-4 md:max-w-md bg-slate-900 border border-slate-800 text-slate-200 p-4 rounded-xl shadow-2xl z-50 hidden flex-col gap-3">
      <div class="text-sm">
        <p>🍪 We use cookies to analyze site traffic and improve your experience on PromptVibe HQ. By continuing to browse, you agree to our use of cookies.</p>
      </div>
      <div class="flex items-center gap-2 justify-end">
        <button id="accept-cookies" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-lg transition-colors">
          Accept All
        </button>
      </div>
    </div>

    <script is:inline>
      const banner = document.getElementById('cookie-banner');
      const acceptBtn = document.getElementById('accept-cookies');

      if (banner && acceptBtn) {
        if (!localStorage.getItem('cookieConsent')) {
          banner.classList.remove('hidden');
          banner.classList.add('flex');
        }

        acceptBtn.addEventListener('click', () => {
          localStorage.setItem('cookieConsent', 'true');
          banner.classList.add('hidden');
          banner.classList.remove('flex');
        });
      }
    </script>
  </body>
</html>